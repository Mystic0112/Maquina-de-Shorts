{
  "name": "maquina-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Painel local do pipeline de Shorts (somente leitura, 127.0.0.1)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include vite.config.ts server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:youtube": "tsx scripts/check-youtube.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
