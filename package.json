{
  "name": "maquina-de-fazer-dinheiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pipeline autônomo de YouTube Shorts de curiosidades",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pipeline": "tsx src/orchestrator/runPipeline.ts",
    "stage": "tsx scripts/run_stage.ts",
    "memes": "tsx scripts/memes.ts",
    "cuts": "tsx scripts/cuts.ts",
    "dashboard": "npm --prefix dashboard run dev",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "auth:youtube": "tsx scripts/auth_youtube_setup.ts",
    "auth:instagram": "tsx scripts/auth_instagram.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@googleapis/youtube": "^40.0.0",
    "@remotion/bundler": "^4.0.532",
    "@remotion/cli": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
