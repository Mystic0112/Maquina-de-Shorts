# Copie para .env e preencha. Nunca commite o .env.

# Provedor de LLM para gerar roteiros: gemini (padrão) | anthropic | antigravity-cli
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo usado para roteiro e metadados
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# antigravity-cli: usa o Antigravity CLI (agy) já logado no PC, sem chave de API (gasta os créditos do plano)
# Binário (nome no PATH ou caminho completo)
ANTIGRAVITY_CLI_PATH=agy
# Modelo (veja `agy models`); vazio = gemini-3.8-flash-medium (thinking escolhe -low/-medium/-high)
ANTIGRAVITY_MODEL=
# Tempo máximo por chamada, em segundos
ANTIGRAVITY_CLI_TIMEOUT_S=180
# Quantos processos agy ao mesmo tempo (o estágio de imagens dispara vários)
ANTIGRAVITY_CLI_CONCURRENCY=2
# Se o agy falhar: none (padrão, custo zero) | gemini (usa a API paga com GEMINI_API_KEY)
ANTIGRAVITY_FALLBACK=none

# API key de leitura do YouTube (não serve para upload; upload exige OAuth abaixo)
YOUTUBE_API_KEY=
# ID do canal (começa com "UC...", em YouTube Studio > Configurações > Canal > Configurações avançadas).
# Usado pelo painel (dashboard/) para mostrar inscritos/views do canal. Vazio = só stats dos vídeos publicados.
YOUTUBE_CHANNEL_ID=

# Caminhos dos arquivos OAuth do YouTube (ficam em secrets/, que é ignorado pelo git)
YT_CLIENT_SECRET_PATH=secrets/youtube.client_secret.json
YT_TOKEN_PATH=secrets/youtube.token.json

# App da Meta ("Instagram API com login do Instagram"): Instagram App ID e Instagram App Secret, em
# Instagram > Configuração da API com login do Instagram > Configurações do login comercial.
# Só usados pelo npm run auth:instagram (o token fica em secrets/instagram.token.json).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Chaves de bancos de footage gratuitos (opcional, usadas pelo adaptador de footage)
PEXELS_API_KEY=
PIXABAY_API_KEY=
